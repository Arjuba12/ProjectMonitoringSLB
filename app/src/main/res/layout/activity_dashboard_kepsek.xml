<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">
            <include layout="@layout/toolbar_portal_kepsek" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Stats Overview -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp"
                    android:weightSum="4">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Siswa" android:textColor="#64748B" android:textSize="10sp"/>
                        <TextView android:id="@+id/tv_total_siswa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#1E293B" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aktif" android:textColor="#94A3B8" android:textSize="10sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Guru" android:textColor="#64748B" android:textSize="10sp"/>
                        <TextView android:id="@+id/tv_total_guru" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#1E293B" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+3 Terapis" android:textColor="#94A3B8" android:textSize="10sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kehadiran Rata" android:textColor="#64748B" android:textSize="10sp"/>
                        <TextView android:id="@+id/tv_kehadiran_rata" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#1E293B" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bulan ini" android:textColor="#94A3B8" android:textSize="10sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Capaian Rata" android:textColor="#64748B" android:textSize="10sp"/>
                        <TextView android:id="@+id/tv_capaian_rata" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#1E293B" android:textSize="20sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Semua aspek" android:textColor="#94A3B8" android:textSize="10sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Ringkasan Status Siswa -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#FFFFFF">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ringkasan status siswa"
                            android:textColor="#1E293B"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="20dp" />

                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                            <TextView android:id="@+id/tv_status_1" android:layout_width="100dp" android:layout_height="wrap_content" android:text="Berkembang baik" android:textColor="#1E293B" android:textSize="13sp"/>
                            <ProgressBar android:layout_width="match_parent" android:layout_height="8dp" android:layout_toEndOf="@id/tv_status_1" android:layout_toStartOf="@id/tv_val_1" android:layout_centerVertical="true" android:layout_marginHorizontal="12dp" style="@android:style/Widget.ProgressBar.Horizontal" android:progress="70" android:progressTint="#166534"/>
                            <TextView android:id="@+id/tv_val_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="38 Siswa" android:textColor="#64748B" android:textSize="13sp"/>
                        </RelativeLayout>

                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
                            <TextView android:id="@+id/tv_status_2" android:layout_width="100dp" android:layout_height="wrap_content" android:text="Cukup berkembang" android:textColor="#1E293B" android:textSize="13sp"/>
                            <ProgressBar android:layout_width="match_parent" android:layout_height="8dp" android:layout_toEndOf="@id/tv_status_2" android:layout_toStartOf="@id/tv_val_2" android:layout_centerVertical="true" android:layout_marginHorizontal="12dp" style="@android:style/Widget.ProgressBar.Horizontal" android:progress="40" android:progressTint="#E67E22"/>
                            <TextView android:id="@+id/tv_val_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="12 Siswa" android:textColor="#64748B" android:textSize="13sp"/>
                        </RelativeLayout>

                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <TextView android:id="@+id/tv_status_3" android:layout_width="100dp" android:layout_height="wrap_content" android:text="Perlu intervensi" android:textColor="#1E293B" android:textSize="13sp"/>
                            <ProgressBar android:layout_width="match_parent" android:layout_height="8dp" android:layout_toEndOf="@id/tv_status_3" android:layout_toStartOf="@id/tv_val_3" android:layout_centerVertical="true" android:layout_marginHorizontal="12dp" style="@android:style/Widget.ProgressBar.Horizontal" android:progress="20" android:progressTint="#EF4444"/>
                            <TextView android:id="@+id/tv_val_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="6 Siswa" android:textColor="#64748B" android:textSize="13sp"/>
                        </RelativeLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Siswa Perlu Perhatian -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#FFFFFF">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Siswa perlu perhatian khusus"
                                android:textColor="#1E293B"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="#94A3B8"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="6 Siswa"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp" />
                        </RelativeLayout>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <TableLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <TableRow android:paddingVertical="8dp">
                                    <TextView android:text="Nama" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" android:paddingEnd="16dp"/>
                                    <TextView android:text="Kelas" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" android:paddingEnd="16dp"/>
                                    <TextView android:text="Hadir" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" android:paddingEnd="16dp"/>
                                    <TextView android:text="Capaian" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" android:paddingEnd="16dp"/>
                                    <TextView android:text="Aspek lemah" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" android:paddingEnd="16dp"/>
                                    <TextView android:text="Guru" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" android:paddingEnd="16dp"/>
                                    <TextView android:text="Aksi" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
                                </TableRow>

                                <View android:layout_height="1dp" android:background="#F1F5F9" />

                                <TableRow android:paddingVertical="10dp" android:gravity="center_vertical">
                                    <TextView android:text="Citra M" android:textColor="#1E293B" android:textSize="11sp" android:paddingEnd="16dp"/>
                                    <TextView android:text="VII-A" android:textColor="#64748B" android:textSize="11sp" android:paddingEnd="16dp"/>
                                    <TextView android:text="79%" android:textColor="#EF4444" android:textSize="11sp" android:paddingEnd="16dp"/>
                                    <TextView android:text="48%" android:textColor="#EF4444" android:textSize="11sp" android:paddingEnd="16dp"/>
                                    <TextView android:text="Kognitif, Sosial" android:textColor="#64748B" android:textSize="11sp" android:paddingEnd="16dp"/>
                                    <TextView android:text="Bu sari" android:textColor="#64748B" android:textSize="11sp" android:paddingEnd="16dp"/>
                                    <com.google.android.material.button.MaterialButton android:layout_width="wrap_content" android:layout_height="28dp" android:text="Tinjau" android:textSize="10sp" android:backgroundTint="#94A3B8" app:cornerRadius="4dp" android:insetTop="0dp" android:insetBottom="0dp" />
                                </TableRow>

                            </TableLayout>
                        </HorizontalScrollView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Kinerja Guru -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#FFFFFF">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kinerja Guru - input perkembangan"
                                android:textColor="#1E293B"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="#94A3B8"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="3 baru"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp" />
                        </RelativeLayout>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <TableLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <TableRow android:paddingVertical="8dp">
                                    <TextView android:text="Nama Guru" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" android:paddingEnd="16dp"/>
                                    <TextView android:text="Kelas" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" android:paddingEnd="16dp"/>
                                    <TextView android:text="Total Input" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" android:paddingEnd="16dp"/>
                                    <TextView android:text="Tepat Waktu" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" android:paddingEnd="16dp"/>
                                    <TextView android:text="Laporan" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" android:paddingEnd="16dp"/>
                                    <TextView android:text="Status" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" />
                                </TableRow>

                                <View android:layout_height="1dp" android:background="#F1F5F9" />

                                <TableRow android:paddingVertical="10dp">
                                    <TextView android:text="Bu Sari" android:textColor="#1E293B" android:textSize="11sp" android:paddingEnd="16dp"/>
                                    <TextView android:text="VII-A,B" android:textColor="#64748B" android:textSize="11sp" android:paddingEnd="16dp"/>
                                    <TextView android:text="42/45" android:textColor="#64748B" android:textSize="11sp" android:paddingEnd="16dp"/>
                                    <TextView android:text="93%" android:textColor="#166534" android:textSize="11sp" android:textStyle="bold" android:paddingEnd="16dp"/>
                                    <TextView android:text="Lengkap" android:textColor="#64748B" android:textSize="11sp" android:paddingEnd="16dp"/>
                                    <TextView android:text="Baik" android:textColor="#166534" android:textSize="11sp" />
                                </TableRow>

                                <TableRow android:paddingVertical="10dp">
                                    <TextView android:text="P Rudi" android:textColor="#1E293B" android:textSize="11sp" android:paddingEnd="16dp"/>
                                    <TextView android:text="VIII-B" android:textColor="#64748B" android:textSize="11sp" android:paddingEnd="16dp"/>
                                    <TextView android:text="12/30" android:textColor="#EF4444" android:textSize="11sp" android:paddingEnd="16dp"/>
                                    <TextView android:text="40%" android:textColor="#EF4444" android:textSize="11sp" android:textStyle="bold" android:paddingEnd="16dp"/>
                                    <TextView android:text="Belum" android:textColor="#64748B" android:textSize="11sp" android:paddingEnd="16dp"/>
                                    <TextView android:text="Perhatian" android:textColor="#EF4444" android:textSize="11sp" />
                                </TableRow>

                            </TableLayout>
                        </HorizontalScrollView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tindak Lanjut Guru -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#FFFFFF">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tindak lanjut guru bermasalah"
                            android:textColor="#1E293B"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#94A3B8"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pak Rudi - tingkat input sangat rendah (40%)"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kelas VIII-B beresiko tidak memiliki data lengkap, perlu tindakan segera."
                                android:textColor="#F1F5F9"
                                android:textSize="12sp"
                                android:layout_marginBottom="16dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <com.google.android.material.button.MaterialButton
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="36dp"
                                    android:text="Kirim Peringatan"
                                    android:textSize="11sp"
                                    android:textAllCaps="false"
                                    android:backgroundTint="#F1F5F9"
                                    android:textColor="#1E293B"
                                    app:cornerRadius="4dp"
                                    android:layout_marginEnd="6dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"/>
                                <com.google.android.material.button.MaterialButton
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="36dp"
                                    android:text="Jadwal Konsultasi"
                                    android:textSize="11sp"
                                    android:textAllCaps="false"
                                    android:backgroundTint="#F1F5F9"
                                    android:textColor="#1E293B"
                                    app:cornerRadius="4dp"
                                    android:layout_marginStart="6dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#FFFFFF"
            app:elevation="8dp"
            app:itemIconTint="@color/bnv_selector"
            app:itemTextColor="@color/bnv_selector"
            app:menu="@menu/bottom_nav_menu_kepsek" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_kepsek"
        app:menu="@menu/drawer_menu_kepsek" />

</androidx.drawerlayout.widget.DrawerLayout>
